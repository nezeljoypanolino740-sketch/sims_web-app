# Copy this file to .env.local and fill in your own values.
# Supabase Dashboard -> Project Settings -> API Keys / Data API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# NEVER put the service_role / secret key, database password or any other
# secret in a VITE_ variable. Vite publishes every VITE_ value to the browser.
